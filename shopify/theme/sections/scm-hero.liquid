{%- render 'scm-home-head' -%}
{%- liquid
  assign title_lines = section.settings.title | strip | newline_to_br | split: '<br />'
  assign primary_link = section.settings.primary_link | default: collections['neu'].url
  assign secondary_link = section.settings.secondary_link | default: collections['second-hand'].url
  assign poster = section.settings.poster | default: images['scm-hero-zwei-models.webp']

  # Bildausschnitt: Fokuspunkt aus Inhalte → Dateien (falls gesetzt), sonst Standard aus dem CSS
  assign focal_style = ''
  if poster.presentation.focal_point != blank
    assign focal_style = 'object-position: ' | append: poster.presentation.focal_point | append: ';'
  endif

  # „Text im Bild“: Überschrift transparent auf dem Bild. „Geteilt“: Bild neben einer schwarzen Textfläche.
  assign layout = 'full'
  if section.settings.video_url == blank and section.settings.image_layout == 'split'
    assign layout = 'split'
  endif
  if layout == 'split'
    assign image_sizes = '(min-width: 990px) 50vw, 100vw'
  else
    assign image_sizes = '100vw'
  endif
-%}

<section class="scm scm-hero scm-hero--{{ layout }} scm-hero--text-{{ section.settings.text_position }}" data-scm-hero>
  <div class="scm-hero__media">
    {%- if section.settings.video_url != blank -%}
      <video
        class="scm-hero__video"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        {% if poster %}poster="{{ poster | image_url: width: 2400 }}"{% endif %}
        aria-hidden="true"
        data-scm-hero-video
      >
        <source src="{{ section.settings.video_url }}" type="video/mp4">
      </video>
    {%- elsif poster -%}
      {{ poster | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '600, 900, 1200, 1500, 1800, 2400', sizes: image_sizes, class: 'scm-hero__video', alt: poster.alt, style: focal_style }}
    {%- endif -%}
  </div>
  <div class="scm-hero__veil" aria-hidden="true"></div>

  <div class="scm-hero__inner">
    {%- if section.settings.kicker != blank -%}
      <p class="scm-kicker scm-hero__kicker" data-scm-intro style="--d: 0">{{ section.settings.kicker }}</p>
    {%- endif -%}
    <h1 class="scm-hero__title">
      {%- for line in title_lines -%}
        <span class="scm-line"><span data-scm-intro style="--d: {{ forloop.index }}">{{ line | strip }}</span></span>
      {%- endfor -%}
    </h1>
    <div class="scm-hero__ctas" data-scm-intro style="--d: {{ title_lines.size | plus: 1 }}">
      {%- if section.settings.primary_label != blank -%}
        <a class="scm-btn scm-btn--light" href="{{ primary_link }}">{{ section.settings.primary_label }}<span class="scm-arrow" aria-hidden="true"></span></a>
      {%- endif -%}
      {%- if section.settings.secondary_label != blank -%}
        <a class="scm-btn scm-btn--ghost-light" href="{{ secondary_link }}">{{ section.settings.secondary_label }}<span class="scm-arrow" aria-hidden="true"></span></a>
      {%- endif -%}
    </div>
    {%- if section.settings.video_url != blank -%}
      <button class="scm-hero__toggle" type="button" aria-pressed="false" aria-label="Video pausieren" data-scm-hero-toggle data-label-pause="Video pausieren" data-label-play="Video abspielen">
        <svg class="scm-hero__icon-pause" viewBox="0 0 16 16" aria-hidden="true"><rect x="3" y="2" width="3.5" height="12"/><rect x="9.5" y="2" width="3.5" height="12"/></svg>
        <svg class="scm-hero__icon-play" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 2l10 6-10 6z"/></svg>
      </button>
    {%- endif -%}
  </div>

  <span class="scm-hero__scroll" aria-hidden="true"><span></span></span>
</section>

{% schema %}
{
  "name": "SCM Hero",
  "tag": "div",
  "class": "scm-section",
  "settings": [
    { "type": "image_picker", "id": "poster", "label": "Bild", "info": "Hauptbild. Den Ausschnitt steuert der Fokuspunkt des Bildes (Inhalte → Dateien). Mit Video dient es als Standbild." },
    { "type": "select", "id": "image_layout", "label": "Aufteilung", "default": "full", "options": [
      { "value": "full", "label": "Text im Bild" },
      { "value": "split", "label": "Geteilt: Text links auf Schwarz, Bild rechts" }
    ] },
    { "type": "select", "id": "text_position", "label": "Textposition Desktop (Text im Bild)", "default": "top", "info": "Mobil steht der Text immer unten im Bild.", "options": [
      { "value": "top", "label": "Oben – für Bilder mit freier Fläche über den Köpfen" },
      { "value": "left", "label": "Links neben der Person – für Bilder mit einer Person in der Mitte" }
    ] },
    { "type": "text", "id": "video_url", "label": "Video-URL (MP4, optional)", "info": "Direkter Link auf eine MP4-Datei. Leer lassen, um nur das Bild zu zeigen." },
    { "type": "text", "id": "kicker", "label": "Kleine Zeile (optional)" },
    { "type": "textarea", "id": "title", "label": "Überschrift", "info": "Jede Zeile wird eine eigene, große Zeile.", "default": "Zweite Chance.\nErste Wahl." },
    { "type": "text", "id": "primary_label", "label": "Button 1", "default": "Neu shoppen" },
    { "type": "url", "id": "primary_link", "label": "Link Button 1", "info": "Leer = Kollektion „Neu“" },
    { "type": "text", "id": "secondary_label", "label": "Button 2", "default": "Second Hand shoppen" },
    { "type": "url", "id": "secondary_link", "label": "Link Button 2", "info": "Leer = Kollektion „Second Hand“" }
  ],
  "presets": [{ "name": "SCM Hero" }]
}
{% endschema %}
