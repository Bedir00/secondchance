{%- render 'scm-home-head' -%}
{%- liquid
  assign world_one = section.settings.collection_one | default: collections['neu']
  assign world_two = section.settings.collection_two | default: collections['second-hand']
  assign limit = section.settings.limit
-%}

<section class="scm scm-rail" data-scm-tabs>
  <div class="scm-head scm-wrap">
    <h2 class="scm-title" data-scm-reveal>{{ section.settings.title }}</h2>
    <div class="scm-head__tools" data-scm-reveal>
      <div class="scm-tabs" role="tablist" aria-label="{{ section.settings.title | escape }}">
        {%- for i in (1..2) -%}
          {%- if i == 1 -%}{%- assign tab_label = section.settings.label_one -%}{%- else -%}{%- assign tab_label = section.settings.label_two -%}{%- endif -%}
          <button
            class="scm-tabs__tab"
            type="button"
            role="tab"
            id="{{ section.id }}-tab-{{ i }}"
            aria-controls="{{ section.id }}-panel-{{ i }}"
            aria-selected="{% if i == 1 %}true{% else %}false{% endif %}"
            {% unless i == 1 %}tabindex="-1"{% endunless %}
            data-scm-tab
          >{{ tab_label }}</button>
        {%- endfor -%}
      </div>
    </div>
  </div>

  {%- for i in (1..2) -%}
    {%- liquid
      if i == 1
        assign world = world_one
      else
        assign world = world_two
      endif
      assign shown = 0
    -%}
    <div
      class="scm-rail__panel"
      role="tabpanel"
      id="{{ section.id }}-panel-{{ i }}"
      aria-labelledby="{{ section.id }}-tab-{{ i }}"
      {% unless i == 1 %}hidden{% endunless %}
      data-scm-panel
      data-scm-rail
    >
      <ul class="scm-rail__track" role="list" data-scm-rail-track tabindex="0" aria-label="{{ section.settings.title | escape }}">
        {%- for product in world.products limit: 40 -%}
          {%- if shown >= limit -%}{%- break -%}{%- endif -%}
          {%- unless product.available -%}{%- continue -%}{%- endunless -%}
          {%- liquid
            assign shown = shown | plus: 1
            assign title_parts = product.title | split: ' | '
            if title_parts.size > 1
              assign card_name = title_parts.first
              assign card_detail = title_parts | slice: 1, 3 | join: ' · '
            else
              assign card_name = product.title
              assign card_detail = ''
            endif
            assign second_image = product.images[1]
          -%}
          <li class="scm-card">
            <a class="scm-card__link" href="{{ product.url }}">
              <span class="scm-card__media{% if second_image %} scm-card__media--swap{% endif %}">
                {%- if product.featured_image -%}
                  {{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300, 450, 600, 900', sizes: '(min-width: 990px) 24vw, 62vw', class: 'scm-card__image', alt: product.featured_image.alt | default: product.title }}
                {%- else -%}
                  {{ 'product-apparel-2' | placeholder_svg_tag: 'scm-card__image' }}
                {%- endif -%}
                {%- if second_image -%}
                  {{ second_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300, 450, 600, 900', sizes: '(min-width: 990px) 24vw, 62vw', class: 'scm-card__image scm-card__image--alt', alt: '' }}
                {%- endif -%}
                {%- if product.compare_at_price > product.price -%}
                  <span class="scm-card__badge">−{{ product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price | round }}%</span>
                {%- endif -%}
              </span>
              <span class="scm-card__meta">
                <span class="scm-card__name">{{ card_name }}</span>
                {%- if card_detail != blank -%}<span class="scm-card__detail">{{ card_detail }}</span>{%- endif -%}
                <span class="scm-card__price">
                  {%- if product.compare_at_price > product.price -%}<s>{{ product.compare_at_price | money_without_currency | append: ' €' }}</s> {% endif -%}
                  {{ product.price | money_without_currency | append: ' €' }}
                </span>
              </span>
            </a>
          </li>
        {%- endfor -%}
        <li class="scm-card scm-card--more">
          <a class="scm-card__more" href="{{ world.url }}">
            <span>{{ section.settings.more_label }}</span>
            <span class="scm-arrow scm-arrow--lg" aria-hidden="true"></span>
          </a>
        </li>
      </ul>
      <div class="scm-rail__footer scm-wrap">
        <div class="scm-rail__progress" aria-hidden="true"><span data-scm-rail-progress></span></div>
        <p class="scm-rail__tax">{{ 'custom.price.tax_shipping' | t }}</p>
        <div class="scm-rail__arrows">
          <button type="button" class="scm-round" aria-label="{{ section.settings.prev_label | escape }}" data-scm-rail-prev><span class="scm-arrow scm-arrow--back" aria-hidden="true"></span></button>
          <button type="button" class="scm-round" aria-label="{{ section.settings.next_label | escape }}" data-scm-rail-next><span class="scm-arrow" aria-hidden="true"></span></button>
        </div>
      </div>
    </div>
  {%- endfor -%}
</section>

{% schema %}
{
  "name": "SCM Neu eingetroffen",
  "tag": "div",
  "class": "scm-section",
  "settings": [
    { "type": "text", "id": "title", "label": "Überschrift", "default": "New In" },
    { "type": "text", "id": "label_one", "label": "Reiter 1", "default": "Neu" },
    { "type": "collection", "id": "collection_one", "label": "Reiter 1 – Kollektion", "info": "Leer = „Neu“. Reihenfolge wie in der Kollektion (am besten: neueste zuerst)." },
    { "type": "text", "id": "label_two", "label": "Reiter 2", "default": "Second Hand" },
    { "type": "collection", "id": "collection_two", "label": "Reiter 2 – Kollektion", "info": "Leer = „Second Hand“" },
    { "type": "range", "id": "limit", "label": "Anzahl Artikel", "min": 4, "max": 24, "step": 1, "default": 12 },
    { "type": "text", "id": "more_label", "label": "Letzte Karte", "default": "Alles ansehen" },
    { "type": "text", "id": "prev_label", "label": "Barrierefreiheit: Zurück", "default": "Vorherige Artikel" },
    { "type": "text", "id": "next_label", "label": "Barrierefreiheit: Weiter", "default": "Nächste Artikel" }
  ],
  "presets": [{ "name": "SCM Neu eingetroffen" }]
}
{% endschema %}
