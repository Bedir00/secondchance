{%- render 'scm-home-head' -%}

<section class="scm scm-looks" data-scm-looks>
  <div class="scm-head scm-wrap">
    <div>
      {%- if section.settings.kicker != blank -%}
        <p class="scm-kicker" data-scm-reveal>{{ section.settings.kicker }}</p>
      {%- endif -%}
      <h2 class="scm-title" data-scm-reveal>{{ section.settings.title }}</h2>
    </div>
    {%- if section.settings.hint != blank -%}
      <p class="scm-looks__hint" data-scm-reveal>{{ section.settings.hint }}</p>
    {%- endif -%}
  </div>

  <ul class="scm-looks__track" role="list">
    {%- for block in section.blocks -%}
      {%- liquid
        # Daten kommen bevorzugt aus dem Metaobjekt „Look“, sonst aus den Block-Feldern
        assign look = block.settings.look
        if look == blank and block.settings.look_handle != blank
          assign look = shop.metaobjects.look[block.settings.look_handle]
        endif
        assign look_number = block.settings.number
        assign look_name = block.settings.name
        assign look_image = block.settings.image
        assign video_src = block.settings.video | strip
        assign look_pieces = blank
        if look != blank
          assign look_number = look.nummer.value | default: look_number
          assign look_name = look.name.value | default: look_name
          assign look_image = look.bild.value | default: look_image
          if look.video.value != blank
            assign video_src = look.video.value | append: ''
          endif
          assign look_pieces = look.teile.value
          # Entwürfe sind im Shop unsichtbar: erst ab zwei sichtbaren Teilen verlinken
          if look_pieces.size < 2
            assign look_pieces = blank
          endif
        endif
        if video_src != blank
          unless video_src contains '//'
            assign video_src = video_src | asset_url
          endunless
        endif

        assign look_link = block.settings.link
        if look_link == blank and look_pieces != blank and look_pieces.size > 0
          assign look_link = look_pieces.first.url
        endif
        assign look_link = look_link | default: collections['neu'].url

        assign pieces = block.settings.pieces | split: ','
      -%}
      <li class="scm-look" {{ block.shopify_attributes }} data-scm-look>
        <a class="scm-look__link" href="{{ look_link }}" data-scm-reveal style="--d: {{ forloop.index0 }}">
          <span class="scm-look__media">
            {%- if look_image -%}
              {{ look_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400, 600, 800, 1000, 1200', sizes: '(min-width: 750px) 33vw, 82vw', class: 'scm-look__image', alt: look_name }}
            {%- else -%}
              {{ 'lifestyle-2' | placeholder_svg_tag: 'scm-look__image' }}
            {%- endif -%}
            {%- if video_src != blank -%}
              <video class="scm-look__video" muted loop playsinline preload="none" aria-hidden="true" data-src="{{ video_src }}" data-scm-look-video></video>
            {%- endif -%}
            <span class="scm-look__number" aria-hidden="true">{{ look_number }}</span>
          </span>
          <span class="scm-look__caption">
            <span class="scm-look__name">{{ look_name }}</span>
            <span class="scm-look__cta">{{ section.settings.cta }}<span class="scm-arrow" aria-hidden="true"></span></span>
          </span>
        </a>
        {%- if look_pieces != blank and look_pieces.size > 0 -%}
          <span class="scm-look__pieces">
            {%- for piece in look_pieces -%}
              {%- assign piece_name = piece.title | split: ' | ' | first -%}
              <a href="{{ piece.url }}">{{ piece_name }}</a>
            {%- endfor -%}
          </span>
        {%- elsif pieces.size > 0 -%}
          <span class="scm-look__pieces">
            {%- for piece in pieces -%}<span>{{ piece | strip }}</span>{%- endfor -%}
          </span>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</section>

{% schema %}
{
  "name": "SCM Looks",
  "tag": "div",
  "class": "scm-section",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kleine Zeile", "default": "Herbst Edit" },
    { "type": "text", "id": "title", "label": "Überschrift", "default": "Shop the Look" },
    { "type": "text", "id": "hint", "label": "Hinweis rechts" },
    { "type": "text", "id": "cta", "label": "Linktext", "default": "Shoppen" }
  ],
  "blocks": [
    {
      "type": "look",
      "name": "Look",
      "settings": [
        { "type": "metaobject", "id": "look", "label": "Look (Metaobjekt)", "metaobject_type": "look", "info": "Bild, Reel, Name und Teile kommen dann aus dem Look. Die Felder darunter sind nur Ersatz." },
        { "type": "text", "id": "look_handle", "label": "Look-Handle (alternativ)", "info": "z. B. look-01-mokka – wird genutzt, wenn oben nichts gewählt ist." },
        { "type": "text", "id": "number", "label": "Nummer", "default": "01" },
        { "type": "text", "id": "name", "label": "Name", "default": "Look" },
        { "type": "image_picker", "id": "image", "label": "Bild (Hochformat)" },
        { "type": "text", "id": "video", "label": "Video (MP4)", "info": "Vollständige URL oder Dateiname eines Theme-Assets. Spielt beim Darüberfahren, mobil im Blickfeld." },
        { "type": "text", "id": "pieces", "label": "Teile (ohne Metaobjekt)", "info": "Mit Komma trennen, z. B. Bluse, Gürtel, Weite Hose" },
        { "type": "url", "id": "link", "label": "Link", "info": "Leer = erstes Teil des Looks bzw. Kollektion „Neu“" }
      ]
    }
  ],
  "presets": [{ "name": "SCM Looks" }]
}
{% endschema %}
