

{% assign product = closest.product %}

{% liquid
  assign scm_badge_label = ''
  if product != blank
    if product.tags contains 'NEU'
      assign scm_badge_label = collections['neu'].title | upcase
    elsif product.tags contains 'SECOND HAND'
      assign scm_badge_label = collections['second-hand'].title | upcase
    else
      for product_collection in product.collections
        if product_collection.handle == 'neu' or product_collection.handle contains 'neu-'
          assign scm_badge_label = collections['neu'].title | upcase
          break
        elsif product_collection.handle == 'second-hand' or product_collection.handle contains 'second-hand-'
          assign scm_badge_label = collections['second-hand'].title | upcase
          break
        endif
      endfor
    endif
  endif
%}

{% capture children %}
  {% unless product == blank %}
    {%- if scm_badge_label != blank or product.available == false or product.compare_at_price > product.price -%}
      <div
        class="product-badges product-badges--top-left"
        style="
          --badge-border-radius: 0;
          --badge-font-family: var(--font-body--family);
          --badge-font-weight: 700;
          --badge-text-transform: uppercase;
        "
      >
        {% if scm_badge_label != blank %}
          <div class="product-badges__badge product-badges__badge--rectangle scm-product-kind-badge">
            {{ scm_badge_label }}
          </div>
        {% endif %}
        {%- if product.available == false or product.compare_at_price > product.price -%}
          <div
            class="
              product-badges__badge product-badges__badge--rectangle
              {% if product.available == false %} color-custom-badge-sold-out{% elsif product.compare_at_price > product.price %} color-custom-badge-sale{% endif %}
            "
          >
            {%- if product.available == false -%}
              {{ 'content.product_badge_sold_out' | t }}
            {%- elsif product.compare_at_price > product.price -%}
              {{ 'content.product_badge_sale' | t }}
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
    {% if product.available and settings.quick_add or settings.mobile_quick_add %}
      {% render 'quick-add', product: product, section_id: section.id %}
    {% endif %}
  {% endunless %}
{% endcapture %}

{% render 'card-gallery', children: children %}

<h3 class="product-grid-view-zoom-out--details">
  {%- if product == blank -%}
    {{- 'content.product_card_placeholder' | t -}}
  {%- else -%}
    {{- product.title -}}
  {%- endif -%}
</h3>

{% render 'product-card-gallery-zoom-details-styles' %}
{% render 'product-badges-styles' %}

{% stylesheet %}
  .product-badges {
    display: grid;
    gap: 5px;
    justify-items: start;
  }

  .product-badges .scm-product-kind-badge {
    min-height: 28px;
    padding: 6px 9px;
    color: #fff;
    background: #2f201b;
    font-size: .62rem;
    letter-spacing: .1em;
    line-height: 1;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.product_image",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:content.resource_reference_product_media"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:options.auto"
        },
        {
          "value": "portrait",
          "label": "t:options.portrait"
        },
        {
          "value": "square",
          "label": "t:options.square"
        },
        {
          "value": "landscape",
          "label": "t:options.landscape"
        }
      ],
      "default": "portrait",
      "label": "t:settings.aspect_ratio",
      "info": "t:info.aspect_ratio_adjusted"
    },
    {
      "type": "header",
      "content": "t:content.borders"
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:settings.style",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "solid",
          "label": "t:options.solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "label": "t:settings.thickness",
      "default": 1,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:settings.opacity",
      "default": 100,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "t:settings.color",
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.product_card_media",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
