{%- liquid
  assign p = closest.product | default: product
  assign m = p.metafields.scm_pdp
  assign accent = m.accent.value | default: section.settings.accent

  assign hero = nil
  for media in p.media
    if media.media_type == 'image' and media.preview_image.width >= 600
      assign hero = media.preview_image
      break
    endif
  endfor
  if hero == nil
    assign hero = p.featured_image
  endif

  assign callouts = m.callouts.value
  assign reasons = m.reasons.value
  assign facts = m.facts.value
-%}

{%- if m.story_title != blank or m.story != blank -%}
{%- render 'scm-motion' -%}
<section
  class="scm-story"
  style="--scm-accent: {{ accent }};"
  data-scm-motion
>
  {%- if hero != blank -%}
    <div class="scm-story__stage" style="--ratio: {{ hero.aspect_ratio }};">
      <div class="scm-story__frame">
        {{
          hero
          | image_url: width: 1400
          | image_tag:
            widths: '480, 720, 960, 1200, 1400',
            sizes: '(min-width: 990px) 560px, 100vw',
            loading: 'lazy',
            class: 'scm-story__img',
            alt: hero.alt
        }}
        <span class="scm-story__light" aria-hidden="true"></span>
      </div>

      {%- if callouts != blank -%}
        {%- assign vh = 100 | divided_by: hero.aspect_ratio -%}
        <svg class="scm-story__lines" viewBox="0 0 100 {{ vh | round: 2 }}" aria-hidden="true">
          {%- for c in callouts -%}
            {%- liquid
              assign k = vh | divided_by: 100.0
              assign ly = c.ly | times: k
              assign ty = c.y | times: k
              assign mx = c.lx | plus: c.x | divided_by: 2.0
              assign my = ly | plus: ty | divided_by: 2.0 | minus: 4
            -%}
            <path
              class="scm-story__path"
              style="--i: {{ forloop.index0 }};"
              d="M {{ c.lx }} {{ ly | round: 2 }} Q {{ mx | round: 2 }} {{ my | round: 2 }} {{ c.x }} {{ ty | round: 2 }}"
              pathLength="1"
            />
          {%- endfor -%}
        </svg>
        <ul class="scm-story__callouts" role="list">
          {%- for c in callouts -%}
            <li
              class="scm-story__label scm-story__label--{{ c.a | default: 'left' }}"
              style="--x: {{ c.lx }}%; --y: {{ c.ly }}%; --i: {{ forloop.index0 }};"
            >
              {{- c.t -}}
            </li>
            <li
              class="scm-story__dot"
              style="--x: {{ c.x }}%; --y: {{ c.y }}%; --i: {{ forloop.index0 }};"
              aria-hidden="true"
            ></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="scm-story__body">
    {%- if m.story_title != blank -%}
      <h2 class="scm-story__title" data-scm-words>{{ m.story_title }}</h2>
    {%- endif -%}
    {%- if m.story != blank -%}
      <p class="scm-story__text scm-reveal">{{ m.story | newline_to_br }}</p>
    {%- endif -%}

    {%- if reasons != blank -%}
      <ul class="scm-story__reasons" role="list">
        {%- for r in reasons -%}
          <li class="scm-reveal" style="--i: {{ forloop.index0 }};">
            <span class="scm-story__rule" aria-hidden="true"></span>
            <p><strong>{{ r.t }}</strong> {{ r.d }}</p>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if facts != blank or p.description != blank -%}
      <details class="scm-story__facts scm-reveal">
        <summary>
          <span>{{ section.settings.facts_label }}</span>
          <span class="scm-story__plus" aria-hidden="true"></span>
        </summary>
        {%- if facts != blank -%}
          <dl>
            {%- for f in facts -%}
              <div><dt>{{ f.k }}</dt><dd>{{ f.v }}</dd></div>
            {%- endfor -%}
          </dl>
        {%- endif -%}
        {%- if p.description != blank and section.settings.show_description -%}
          <div class="scm-story__desc">{{ p.description }}</div>
        {%- endif -%}
      </details>
    {%- endif -%}
  </div>
</section>
{%- endif -%}

{% stylesheet %}
.scm-story { --scm-ink:#111; --scm-mute:#5f5a55; --scm-line:#e7e2dc; --scm-paper:#f6f3ef; --scm-ease:cubic-bezier(.22,.61,.36,1); color:var(--scm-ink); background:#fff; padding:8px 0 40px; }
.scm-story__stage { position:relative; width:100%; aspect-ratio:var(--ratio); max-height:88svh; overflow:hidden; background:var(--scm-paper); }
.scm-story__frame { position:absolute; inset:0; overflow:hidden; transition:clip-path 1.4s var(--scm-ease); }
.scm-motion .scm-story__frame { clip-path:inset(12% 0 0 0); }
.scm-story__img { width:100%; height:100%; object-fit:cover; object-position:50% 20%; transition:transform 2.6s var(--scm-ease); will-change:transform; }
.scm-motion .scm-story__img { transform:scale(1.12); }
.scm-motion .scm-story.is-in .scm-story__frame { clip-path:inset(0 0 0 0); }
.scm-motion .scm-story.is-in .scm-story__img { transform:scale(1); animation:scm-drift 16s ease-in-out 2.6s infinite alternate; }
.scm-story__light { position:absolute; inset:-20%; pointer-events:none; background:linear-gradient(115deg, transparent 38%, rgba(255,248,236,.38) 48%, rgba(255,248,236,.12) 56%, transparent 64%); transform:translateX(-70%); opacity:0; mix-blend-mode:soft-light; }
.scm-story.is-in .scm-story__light { animation:scm-light 11s ease-in-out 1.8s infinite; }
.scm-story__lines { position:absolute; inset:0; width:100%; height:100%; overflow:visible; pointer-events:none; }
.scm-story__path { fill:none; stroke:rgba(28,24,22,.72); stroke-width:.32; stroke-linecap:round; stroke-dasharray:1; stroke-dashoffset:0; transition:stroke-dashoffset 1.1s var(--scm-ease); transition-delay:calc(1.5s + var(--i) * .45s); }
.scm-motion .scm-story__path { stroke-dashoffset:1; }
.scm-motion .scm-story.is-in .scm-story__path { stroke-dashoffset:0; }
.scm-story__callouts { position:absolute; inset:0; margin:0; padding:0; list-style:none; pointer-events:none; }
.scm-story__label { position:absolute; top:var(--y); max-width:34%; padding:5px 10px; border-radius:999px; background:rgba(255,255,255,.92); box-shadow:0 1px 2px rgba(0,0,0,.06), 0 0 0 1px rgba(0,0,0,.05); -webkit-backdrop-filter:blur(6px); backdrop-filter:blur(6px); color:var(--scm-ink); font-size:11.5px; font-weight:500; line-height:1.25; letter-spacing:.01em; transform:translateY(-50%); transition:opacity .7s var(--scm-ease), transform .7s var(--scm-ease); transition-delay:calc(1.2s + var(--i) * .45s); }
.scm-motion .scm-story__label { opacity:0; transform:translateY(calc(-50% + 6px)); }
.scm-story__label--left { left:var(--x); max-width:min(34%, calc(100% - var(--x) - 8px)); }
.scm-story__label--right { right:calc(100% - var(--x)); max-width:min(34%, calc(var(--x) - 8px)); text-align:right; }
.scm-story__dot { position:absolute; left:var(--x); top:var(--y); width:9px; height:9px; margin:-4.5px 0 0 -4.5px; border-radius:50%; background:#fff; box-shadow:0 0 0 1.5px rgba(28,24,22,.75), 0 1px 3px rgba(0,0,0,.2); transition:opacity .5s ease, transform .5s var(--scm-ease); transition-delay:calc(2.4s + var(--i) * .45s); }
.scm-motion .scm-story__dot { opacity:0; transform:scale(.4); }
.scm-story__dot::after { content:''; position:absolute; inset:-6px; border-radius:50%; border:1px solid rgba(28,24,22,.45); opacity:0; }
.scm-motion .scm-story.is-in .scm-story__label { opacity:1; transform:translateY(-50%); }
.scm-motion .scm-story.is-in .scm-story__dot { opacity:1; transform:scale(1); }
.scm-story.is-in .scm-story__dot::after { animation:scm-pulse 3.2s ease-out calc(3s + var(--i) * .45s) infinite; }
.scm-story__body { max-width:620px; margin:0 auto; padding:28px 20px 0; }
.scm-story__title { margin:0; font-family:var(--font-heading--family, inherit); font-weight:var(--font-heading--weight, 500); font-size:clamp(1.55rem, 6.4vw, 2.25rem); line-height:1.12; letter-spacing:-.015em; text-wrap:balance; }
.scm-story__title .w { display:inline-block; transition:opacity .8s var(--scm-ease), transform .8s var(--scm-ease); transition-delay:calc(.15s + var(--w) * 70ms); }
.scm-motion .scm-story__title .w { opacity:0; transform:translateY(.45em); }
.scm-motion .scm-story__title.is-in .w { opacity:1; transform:none; }
.scm-story__text { margin:16px 0 0; color:var(--scm-mute); font-size:.95rem; line-height:1.65; }
.scm-story__reasons { margin:28px 0 0; padding:0; list-style:none; display:grid; gap:18px; }
.scm-story__reasons li { display:grid; grid-template-columns:22px 1fr; gap:12px; align-items:start; }
.scm-story__reasons p { margin:0; font-size:.92rem; line-height:1.55; color:var(--scm-mute); }
.scm-story__reasons strong { color:var(--scm-ink); font-weight:600; }
.scm-story__rule { display:block; height:1px; margin-top:.78em; background:var(--scm-accent, #2a2420); transform-origin:left; transition:transform .9s var(--scm-ease); transition-delay:calc(.1s + var(--i) * .15s); }
.scm-motion .scm-story__rule { transform:scaleX(0); }
.scm-motion .scm-story__reasons li.is-in .scm-story__rule { transform:scaleX(1); }
.scm-story__facts { margin-top:30px; border-top:1px solid var(--scm-line); border-bottom:1px solid var(--scm-line); }
.scm-story__facts summary { display:flex; align-items:center; justify-content:space-between; min-height:52px; cursor:pointer; list-style:none; font-size:.9rem; font-weight:600; }
.scm-story__facts summary::-webkit-details-marker { display:none; }
.scm-story__plus { position:relative; width:12px; height:12px; }
.scm-story__plus::before, .scm-story__plus::after { content:''; position:absolute; left:0; top:50%; width:12px; height:1px; background:currentColor; transition:transform .3s var(--scm-ease); }
.scm-story__plus::after { transform:rotate(90deg); }
.scm-story__facts[open] .scm-story__plus::after { transform:rotate(0); }
.scm-story__facts dl { margin:0; padding:0 0 12px; }
.scm-story__facts dl div { display:flex; justify-content:space-between; gap:16px; padding:9px 0; border-top:1px solid var(--scm-line); font-size:.86rem; }
.scm-story__facts dt { color:var(--scm-mute); }
.scm-story__facts dd { margin:0; text-align:right; font-weight:500; }
.scm-story__desc { padding:4px 0 16px; color:var(--scm-mute); font-size:.84rem; line-height:1.6; }
@keyframes scm-drift { from { transform:scale(1) translate3d(0,0,0); } to { transform:scale(1.04) translate3d(0,-1.2%,0); } }
@keyframes scm-light { 0% { transform:translateX(-70%); opacity:0; } 15% { opacity:1; } 55% { transform:translateX(70%); opacity:0; } 100% { transform:translateX(70%); opacity:0; } }
@keyframes scm-pulse { 0% { transform:scale(.6); opacity:.9; } 70%,100% { transform:scale(1.6); opacity:0; } }
@media (min-width:990px) {
  .scm-story { display:grid; grid-template-columns:minmax(0,560px) minmax(0,520px); justify-content:center; align-items:center; gap:72px; padding:48px 32px 72px; }
  .scm-story__stage { max-height:none; }
  .scm-story__body { padding:0; margin:0; }
}
@media (prefers-reduced-motion:reduce) {
  .scm-story *, .scm-story *::before, .scm-story *::after { animation:none !important; transition:none !important; }
  .scm-story__frame { clip-path:none; }
  .scm-story__img { transform:none; }
  .scm-story__path { stroke-dashoffset:0; }
  .scm-story__label, .scm-story__dot, .scm-reveal, .scm-story__title .w { opacity:1; transform:none; }
  .scm-story__label { transform:translateY(-50%); }
  .scm-story__rule { transform:none; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "SCM Neuware Story",
  "settings": [
    { "type": "color", "id": "accent", "label": "Akzentfarbe (Fallback)", "default": "#2A2420" },
    { "type": "text", "id": "facts_label", "label": "Titel Details", "default": "Maße, Material & Details" },
    { "type": "checkbox", "id": "show_description", "label": "Originalbeschreibung in Details zeigen", "default": true }
  ],
  "presets": [{ "name": "SCM Neuware Story" }]
}
{% endschema %}
