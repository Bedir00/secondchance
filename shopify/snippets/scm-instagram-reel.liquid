{% doc %}
  Renders the CHANCE FASHION Instagram Reel in a responsive iframe.

  @param {string} [reel_url] - Instagram embed URL.
  @param {string} [attributes] - Extra attributes (z. B. block.shopify_attributes).
{% enddoc %}

{%- assign reel_url = reel_url | default: 'https://www.instagram.com/reel/DZP6Rujsb9a/embed/' -%}
<div class="scm-instagram-reel" {{ attributes }}>
  <iframe
    src="{{ reel_url }}"
    title="{{ 'scm_reel.iframe_title' | t }}"
    width="420"
    height="780"
    loading="lazy"
    allow="autoplay; encrypted-media; fullscreen"
    allowfullscreen
  ></iframe>
</div>

<script>
  // Höhe des Reels an den Instagram-Inhalt anpassen (Instagram meldet sie per postMessage „MEASURE“),
  // damit unten im iframe keine leere weiße Fläche bleibt. Ohne Meldung bleibt die CSS-Höhe.
  (() => {
    if (window.scmReelResize) return;
    window.scmReelResize = true;
    window.addEventListener('message', (event) => {
      if (!/^https:\/\/(www\.)?instagram\.com$/.test(event.origin)) return;
      let data = event.data;
      if (typeof data === 'string') {
        try {
          data = JSON.parse(data);
        } catch (error) {
          return;
        }
      }
      const height = data && data.type === 'MEASURE' && data.details ? Number(data.details.height) : 0;
      if (!height) return;
      document.querySelectorAll('.scm-instagram-reel iframe').forEach((frame) => {
        if (frame.contentWindow === event.source) frame.style.height = `${Math.ceil(height)}px`;
      });
    });
  })();
</script>

{% stylesheet %}
  .scm-instagram-reel {
    width: 100%;
    max-width: 420px;
    margin-inline: auto;
    /* Gleicher Weißraum über und unter dem Reel (zusätzlich zum Spalten-Gap) */
    margin-block: 16px;
    background: #FFFFFF;
  }

  .scm-instagram-reel iframe {
    display: block;
    width: 100%;
    height: 780px;
    border: 0;
    background: #FFFFFF;
  }
{% endstylesheet %}
