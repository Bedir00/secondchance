{% doc %}
  Renders product sizing information above the add-to-cart button.
  @param {string} dialog_id - Unique dialog identifier.
{% enddoc %}

<dialog-component id="{{ dialog_id }}" class="scm-size-info">
  <button
    type="button"
    class="button-unstyled scm-size-info__link"
    on:click="/showDialog"
    aria-haspopup="dialog"
    aria-controls="{{ dialog_id }}-window"
  >
    {{ 'scm.size_info.link' | t }}
  </button>
  <dialog
    id="{{ dialog_id }}-window"
    ref="dialog"
    class="scm-size-info__window"
    aria-labelledby="{{ dialog_id }}-heading"
  >
    <button
      type="button"
      class="button-unstyled scm-size-info__close"
      on:click="/closeDialog"
      aria-label="{{ 'actions.close' | t }}"
      autofocus
    >
      <span class="svg-wrapper">{{ 'icon-close.svg' | inline_asset_content }}</span>
    </button>
    <h2 id="{{ dialog_id }}-heading">{{ 'scm.size_info.heading' | t }}</h2>
    <p>{{ 'scm.size_info.body' | t }}</p>
    <p>{{ 'scm.size_info.description' | t }}</p>
    <p class="scm-size-info__hint">{{ 'scm.size_info.hint' | t }}</p>
  </dialog>
</dialog-component>

<script src="{{ 'dialog.js' | asset_url }}" type="module"></script>

{% stylesheet %}
  .product-form-buttons > dialog-component.scm-size-info {
    display: block;
    flex: 0 0 100% !important;
    min-width: 0 !important;
    width: 100%;
    text-align: left;
  }

  .product-form-buttons .scm-size-info .scm-size-info__link {
    display: inline-flex;
    align-items: center;
    justify-content: flex-start;
    width: auto;
    min-height: 44px;
    padding: 0;
    margin: 0;
    color: var(--color-foreground);
    font-family: var(--font-body--family);
    font-size: 14px;
    font-weight: 400;
    line-height: 1.4;
    text-align: left;
    text-transform: none;
    text-decoration: underline;
    text-underline-offset: 4px;
    cursor: pointer;
    touch-action: manipulation;
  }

  .scm-size-info__link:focus-visible,
  .scm-size-info__close:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  .scm-size-info__window {
    position: fixed;
    inset: 0;
    width: min(520px, calc(100vw - 32px));
    max-width: calc(100vw - 32px);
    max-height: calc(100dvh - 48px);
    margin: auto;
    padding: 36px 28px 28px;
    border: 1px solid var(--color-border, #dedede);
    border-radius: 0;
    background: var(--color-background, #fff);
    color: var(--color-foreground, #2a2420);
    font-family: var(--font-body--family);
    overflow-y: auto;
    overscroll-behavior: contain;
    text-align: left;
  }

  .scm-size-info__window::backdrop {
    background: rgb(0 0 0 / 45%);
  }

  .scm-size-info__window h2 {
    margin: 0 40px 20px 0;
    font-family: var(--font-body--family);
    font-size: clamp(18px, 4vw, 22px);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0.04em;
    text-wrap: balance;
  }

  .scm-size-info__window p {
    margin: 0 0 16px;
    font-size: 15px;
    line-height: 1.65;
  }

  .scm-size-info__window .scm-size-info__hint {
    margin: 24px 0 0;
    padding-top: 16px;
    border-top: 1px solid var(--color-border, #dedede);
    font-size: 13px;
    line-height: 1.5;
  }

  .product-form-buttons .scm-size-info .scm-size-info__close {
    position: absolute;
    inset-block-start: 8px;
    inset-inline-end: 8px;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 10px;
    border: 0;
    color: inherit;
    background: transparent;
    cursor: pointer;
    touch-action: manipulation;
  }

  .scm-size-info__close .svg-wrapper {
    width: 20px;
    height: 20px;
  }
{% endstylesheet %}
