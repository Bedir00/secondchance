{%- comment -%}
  SCM Motion Story: Scroll-Erlebnis im Stil der Apple-AirPods-Seiten, in der CI von CHANCE FASHION.
  1. Auftakt: Glühen, Verlaufs-Headline Wort für Wort, Produkt schwebt nach vorn
  2. Rundum: Produktvideo wird vom Scrollen vor- und zurückgespult, dahinter ein laufendes Outline-Wort
  3. Im Detail: Beschriftungen zeichnen sich mit Linien an das Produkt (Punkte aus scm_pdp.passform_hinweise)
  4. Details: Bild bleibt stehen und blendet pro Text über
  5. Auf einen Blick: Kacheln, Zahlen zählen hoch
  6. Abschluss mit Preis und Sprung zum Warenkorb-Button
  Bilder und Video kommen aus den Produktmedien. Bei „Bewegung reduzieren“ ist alles statisch.
{%- endcomment -%}

{%- liquid
  assign images = product.media | where: 'media_type', 'image'
  assign video = product.media | where: 'media_type', 'video' | first
  assign hero_image = images[0]
  assign variant = product.selected_or_first_available_variant
  assign spots = product.metafields.scm_pdp.passform_hinweise.value.points
  assign sid = section.id
-%}

{%- if product != blank and hero_image != blank -%}
  <section class="scm-ms" id="scm-ms-{{ sid }}" aria-label="{{ section.settings.hero_kicker | escape }}">
    {%- comment -%} 1 · Auftakt {%- endcomment -%}
    <div class="scm-ms__stage scm-ms__stage--hero" data-stage>
      <div class="scm-ms__sticky scm-ms__hero">
        <span class="scm-ms__glow" aria-hidden="true"></span>
        <div class="scm-ms__hero-copy">
          <p class="scm-ms__kicker">{{ section.settings.hero_kicker }}</p>
          <h2 class="scm-ms__headline">
            {%- assign lines = section.settings.hero_lines | newline_to_br | split: '<br />' -%}
            {%- for line in lines -%}
              {%- assign l = line | strip -%}
              {%- if l != blank -%}
                <span class="scm-ms__line" style="--i: {{ forloop.index0 }}">{{ l }}</span>
              {%- endif -%}
            {%- endfor -%}
          </h2>
        </div>
        <div class="scm-ms__hero-media">
          {{
            hero_image.preview_image
            | image_url: width: 1600
            | image_tag:
              widths: '600, 900, 1200, 1600',
              sizes: '(min-width: 990px) 46vw, 86vw',
              loading: 'lazy',
              alt: hero_image.alt
          }}
        </div>
      </div>
    </div>

    {%- comment -%} 2 · Rundum (Video per Scroll gespult) {%- endcomment -%}
    {%- if video != blank -%}
      {%- liquid
        assign video_src = ''
        for source in video.sources
          if source.format == 'mp4' and source.height == 720
            assign video_src = source.url
          endif
        endfor
        if video_src == blank
          for source in video.sources
            if source.format == 'mp4' and video_src == blank
              assign video_src = source.url
            endif
          endfor
        endif
      -%}
      <div class="scm-ms__stage scm-ms__stage--scrub" data-stage>
        <div class="scm-ms__sticky scm-ms__scrub">
          <span class="scm-ms__bigword" aria-hidden="true">{{ section.settings.big_word }}</span>
          <span class="scm-ms__glow scm-ms__glow--soft" aria-hidden="true"></span>
          <div class="scm-ms__scrub-frame">
            <video
              data-scrub
              muted
              playsinline
              preload="auto"
              poster="{{ video.preview_image | image_url: width: 900 }}"
              aria-label="{{ product.title | escape }} – Video"
            >
              <source src="{{ video_src }}" type="video/mp4">
            </video>
          </div>
          <div class="scm-ms__captions">
            {%- for n in (1..3) -%}
              {%- capture k %}scrub_caption_{{ n }}{% endcapture -%}
              <p class="scm-ms__caption" style="--i: {{ forloop.index0 }}">{{ section.settings[k] }}</p>
            {%- endfor -%}
          </div>
        </div>
      </div>
    {%- endif -%}

    {%- comment -%} 3 · Im Detail (Linien-Beschriftungen) {%- endcomment -%}
    {%- if spots.size > 0 -%}
      <div class="scm-ms__stage scm-ms__stage--spots" data-stage style="--n: {{ spots.size }}">
        <div class="scm-ms__sticky scm-ms__spots">
          <p class="scm-ms__kicker scm-ms__spots-kicker">{{ section.settings.spots_kicker }}</p>
          <div class="scm-ms__spot-media" style="aspect-ratio: {{ hero_image.preview_image.aspect_ratio | default: 1 }}">
            {{
              hero_image.preview_image
              | image_url: width: 1400
              | image_tag:
                widths: '600, 900, 1400',
                sizes: '(min-width: 990px) 44vw, 92vw',
                loading: 'lazy',
                alt: ''
            }}
            {%- for spot in spots -%}
              {%- liquid
                # Schild auf die Seite mit mehr Platz, damit es auf dem Handy nicht aus dem Bild ragt
                assign spot_x = spot.x | plus: 0
                assign spot_side = 'right'
                if spot.side == 'left'
                  assign spot_side = 'left'
                endif
                if spot_side == 'left' and spot_x < 42
                  assign spot_side = 'right'
                elsif spot_side == 'right' and spot_x > 58
                  assign spot_side = 'left'
                endif
              -%}
              <div
                class="scm-ms__spot scm-ms__spot--{{ spot_side }}"
                style="--x: {{ spot.x }}%; --y: {{ spot.y }}%; --i: {{ forloop.index0 }}"
              >
                <span class="scm-ms__spot-dot"></span>
                <span class="scm-ms__spot-line"></span>
                <span class="scm-ms__spot-tag">
                  <b>{{ spot.label }}</b>
                  {{ spot.title }}
                </span>
              </div>
            {%- endfor -%}
          </div>
        </div>
      </div>
    {%- endif -%}

    {%- comment -%} 4 · Details {%- endcomment -%}
    <div class="scm-ms__features">
      <div class="scm-ms__features-media" aria-hidden="true">
        {%- for n in (1..3) -%}
          {%- assign idx = n | modulo: images.size -%}
          {%- assign img = images[idx] -%}
          <div class="scm-ms__feature-img{% if forloop.first %} is-active{% endif %}" data-feature-img="{{ forloop.index0 }}">
            {{
              img.preview_image
              | image_url: width: 1400
              | image_tag:
                widths: '600, 900, 1400',
                sizes: '(min-width: 990px) 50vw, 100vw',
                loading: 'lazy',
                alt: ''
            }}
          </div>
        {%- endfor -%}
        <span class="scm-ms__progress"><span data-feature-bar></span></span>
      </div>
      <div class="scm-ms__features-text">
        {%- for n in (1..3) -%}
          {%- capture k_title %}feature_{{ n }}_title{% endcapture -%}
          {%- capture k_text %}feature_{{ n }}_text{% endcapture -%}
          <article class="scm-ms__feature{% if forloop.first %} is-active{% endif %}" data-feature="{{ forloop.index0 }}">
            <div class="scm-ms__feature-card">
              <p class="scm-ms__index">0{{ n }}</p>
              <h3 class="scm-ms__feature-title">{{ section.settings[k_title] }}</h3>
              <p class="scm-ms__feature-text">{{ section.settings[k_text] }}</p>
            </div>
          </article>
        {%- endfor -%}
      </div>
    </div>

    {%- comment -%} 5 · Auf einen Blick {%- endcomment -%}
    <div class="scm-ms__facts">
      <p class="scm-ms__kicker">{{ section.settings.facts_kicker }}</p>
      <ul class="scm-ms__facts-grid" role="list">
        {%- for n in (1..4) -%}
          {%- capture k_big %}fact_{{ n }}_big{% endcapture -%}
          {%- capture k_small %}fact_{{ n }}_small{% endcapture -%}
          {%- if section.settings[k_big] != blank -%}
            <li class="scm-ms__fact" data-reveal style="--d: {{ forloop.index0 }}">
              <span class="scm-ms__fact-big" data-count>{{ section.settings[k_big] }}</span>
              <span class="scm-ms__fact-small">{{ section.settings[k_small] }}</span>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>

    {%- comment -%} 6 · Abschluss {%- endcomment -%}
    <div class="scm-ms__outro">
      <span class="scm-ms__glow scm-ms__glow--outro" aria-hidden="true"></span>
      <div class="scm-ms__outro-inner" data-reveal>
        <h2 class="scm-ms__outro-title">{{ section.settings.outro_title }}</h2>
        <p class="scm-ms__price">{{ variant.price | money }}</p>
        <a class="scm-ms__cta" href="#MainContent" data-scm-ms-top>{{ section.settings.cta_label }}</a>
      </div>
    </div>
  </section>

  <script>
    (() => {
      const root = document.getElementById('scm-ms-{{ sid }}');
      if (!root || root.dataset.ready) return;
      root.dataset.ready = '1';
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce) root.classList.add('is-static');

      // Scroll-Fortschritt je Bühne als --p (0 → 1)
      const stages = [...root.querySelectorAll('[data-stage]')];
      const video = root.querySelector('[data-scrub]');
      const scrubStage = video && video.closest('[data-stage]');
      let duration = 0;
      let wantTime = 0;
      let seeking = false;

      const seek = () => {
        if (!video || !duration || seeking) return;
        if (Math.abs(video.currentTime - wantTime) < 0.03) return;
        seeking = true;
        if (typeof video.fastSeek === 'function') video.fastSeek(wantTime); else video.currentTime = wantTime;
      };
      if (video) {
        video.addEventListener('seeked', () => { seeking = false; seek(); });
        video.addEventListener('loadedmetadata', () => { duration = video.duration || 0; update(); });
        // iOS lädt Videodaten erst nach play(): einmal kurz anstoßen
        const prime = () => {
          video.play().then(() => video.pause()).catch(() => {});
          removeEventListener('touchstart', prime);
          removeEventListener('scroll', prime);
        };
        addEventListener('touchstart', prime, { once: true, passive: true });
        addEventListener('scroll', prime, { once: true, passive: true });
        if (reduce) video.setAttribute('controls', '');
      }

      let ticking = false;
      function update() {
        ticking = false;
        const vh = innerHeight;
        for (const stage of stages) {
          const r = stage.getBoundingClientRect();
          const total = Math.max(1, r.height - vh);
          const p = Math.min(1, Math.max(0, -r.top / total));
          stage.style.setProperty('--p', p.toFixed(4));
          if (stage === scrubStage && duration) {
            wantTime = Math.min(duration - 0.05, p * duration);
            seek();
          }
        }
      }
      if (!reduce) {
        addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
        addEventListener('resize', update);
        update();
      }

      // Details: aktiven Text erkennen, Bild überblenden
      const feats = [...root.querySelectorAll('[data-feature]')];
      const imgs = [...root.querySelectorAll('[data-feature-img]')];
      const bar = root.querySelector('[data-feature-bar]');
      const setActive = (i) => {
        feats.forEach((f, n) => f.classList.toggle('is-active', n === i));
        imgs.forEach((f, n) => f.classList.toggle('is-active', n === i));
        if (bar) bar.style.transform = `scaleX(${(i + 1) / feats.length})`;
      };
      const featObserver = new IntersectionObserver((entries) => {
        entries.forEach((e) => { if (e.isIntersecting) setActive(Number(e.target.dataset.feature)); });
      }, { rootMargin: '-45% 0px -45% 0px' });
      feats.forEach((f) => featObserver.observe(f));
      setActive(0);

      // Zahlen hochzählen („14 Tage“, „38/40“ …)
      const countUp = (el) => {
        const text = el.textContent.trim();
        const match = text.match(/^(\d+)(.*)$/s);
        if (!match || reduce) return;
        const target = Number(match[1]);
        const rest = match[2];
        const start = performance.now();
        const tick = (t) => {
          const k = Math.min(1, (t - start) / 1100);
          const eased = 1 - Math.pow(1 - k, 3);
          el.textContent = Math.round(target * eased) + rest;
          if (k < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      };

      // Kacheln und Abschluss gleiten herein
      const revealObserver = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          e.target.classList.add('is-in');
          e.target.querySelectorAll('[data-count]').forEach(countUp);
          revealObserver.unobserve(e.target);
        });
      }, { threshold: 0.3 });
      root.querySelectorAll('[data-reveal]').forEach((el) => revealObserver.observe(el));

      // Zum Warenkorb-Button der Produktseite
      root.querySelector('[data-scm-ms-top]')?.addEventListener('click', (event) => {
        const target = document.querySelector('.product-details, #MainContent');
        if (!target) return;
        event.preventDefault();
        target.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
      });
    })();
  </script>
{%- endif -%}

{% stylesheet %}
  .scm-ms {
    --ms-ink: #2a2420;
    --ms-night: #1a1512;
    --ms-paper: #f6f2ed;
    --ms-taupe: #c9b8a6;
    --ms-white: #fff;
    --ms-red: #c62828;
    --ms-head: var(--font-heading--family, var(--font-body--family));
    --ms-gradient: linear-gradient(100deg, #fff 0%, var(--ms-taupe) 55%, #e07a5f 100%);

    background: var(--ms-night);
    color: var(--ms-white);
    font-family: var(--font-body--family);
    overflow: clip;
  }

  .scm-ms__kicker {
    margin: 0 0 18px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    opacity: 0.8;
  }

  .scm-ms__kicker::before {
    content: '';
    display: inline-block;
    width: 28px;
    height: 2px;
    margin-inline-end: 12px;
    vertical-align: middle;
    background: var(--ms-red);
  }

  .scm-ms__stage {
    --p: 0;
    position: relative;
  }

  .scm-ms__sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    box-sizing: border-box;
    overflow: hidden;
  }

  /* Warmes Glühen hinter dem Produkt */
  .scm-ms__glow {
    position: absolute;
    left: 50%;
    top: 58%;
    width: 120vmin;
    aspect-ratio: 1;
    background: radial-gradient(circle, rgb(201 184 166 / 45%) 0%, rgb(198 40 40 / 12%) 38%, transparent 66%);
    transform: translate(-50%, -50%) scale(calc(0.55 + var(--p, 0) * 0.65));
    opacity: calc(0.35 + var(--p, 0) * 0.65);
    pointer-events: none;
    will-change: transform, opacity;
  }

  /* 1 · Auftakt */
  .scm-ms__stage--hero {
    height: 260vh;
  }

  .scm-ms__hero {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    justify-items: center;
    padding: clamp(48px, 9vh, 96px) 20px 0;
    text-align: center;
  }

  .scm-ms__hero-copy {
    --out: clamp(0, calc((var(--p) - 0.62) * 3.2), 1);

    position: relative;
    z-index: 2;
    opacity: calc(1 - var(--out));
    transform: translateY(calc(var(--out) * -8vh)) scale(calc(1 - var(--out) * 0.12));
  }

  .scm-ms__headline {
    margin: 0;
    font-family: var(--ms-head);
    font-size: clamp(44px, min(11vw, 12svh), 128px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.035em;
  }

  .scm-ms__line {
    --show: clamp(0, calc(var(--p) * 6 - var(--i) * 0.85), 1);

    display: block;
    padding-bottom: 0.06em;
    background: var(--ms-gradient);
    background-size: 220% 100%;
    background-position: calc(100% - var(--show) * 100%) 0;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    opacity: var(--show);
    filter: blur(calc((1 - var(--show)) * 10px));
    transform: translateY(calc((1 - var(--show)) * 0.4em));
  }

  .scm-ms__hero-media {
    --rise: clamp(0, calc(var(--p) * 1.4), 1);

    position: relative;
    z-index: 1;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    width: 100%;
    height: 100%;
    min-height: 0;
    padding-top: 16px;
    box-sizing: border-box;
    opacity: calc(0.2 + var(--rise) * 0.8);
    transform: translateY(calc((1 - var(--rise)) * 30%)) scale(calc(0.82 + var(--rise) * 0.18 + clamp(0, calc(var(--p) - 0.62), 1) * 0.18));
    transform-origin: 50% 85%;
    will-change: transform, opacity;
  }

  .scm-ms__hero-media img {
    display: block;
    width: auto;
    max-width: min(90vw, 760px);
    height: 100%;
    object-fit: contain;
    object-position: bottom;
    filter: drop-shadow(0 40px 60px rgb(0 0 0 / 45%));
  }

  /* 2 · Rundum */
  .scm-ms__stage--scrub {
    height: 320vh;
  }

  .scm-ms__scrub {
    display: grid;
    place-items: center;
    background: var(--ms-night);
  }

  .scm-ms__bigword {
    position: absolute;
    top: 50%;
    left: 0;
    font-family: var(--ms-head);
    font-size: clamp(120px, 34vw, 420px);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
    white-space: nowrap;
    color: transparent;
    -webkit-text-stroke: 1.5px rgb(201 184 166 / 40%);
    transform: translate(calc(30vw - var(--p) * 140%), -50%);
    will-change: transform;
  }

  .scm-ms__glow--soft {
    top: 50%;
  }

  .scm-ms__scrub-frame {
    position: relative;
    z-index: 1;
    width: min(70vw, 40svh, 380px);
    aspect-ratio: 9 / 16;
    overflow: hidden;
    box-shadow: 0 40px 90px rgb(0 0 0 / 55%);
    transform: scale(calc(0.86 + min(var(--p) * 4, 1) * 0.14));
  }

  .scm-ms__scrub-frame video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .scm-ms__captions {
    position: absolute;
    inset-inline: 0;
    bottom: clamp(28px, 7vh, 72px);
    z-index: 2;
    display: grid;
    text-align: center;
  }

  .scm-ms__caption {
    --a: clamp(0, calc((var(--p) * 3 - var(--i)) * 4), 1);
    --b: clamp(0, calc((var(--p) * 3 - var(--i) - 0.85) * 6), 1);

    grid-area: 1 / 1;
    margin: 0;
    padding: 0 20px;
    font-family: var(--ms-head);
    font-size: clamp(28px, 7.5vw, 64px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.05;
    opacity: calc(var(--a) - var(--b));
    transform: translateY(calc((1 - var(--a)) * 24px + var(--b) * -24px));
  }

  .scm-ms__caption:last-child {
    --b: 0;
  }

  /* 3 · Im Detail */
  .scm-ms__stage--spots {
    height: calc(120vh + var(--n) * 55vh);
  }

  .scm-ms__spots {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    justify-items: center;
    padding: clamp(40px, 8vh, 80px) 12px 24px;
    background: var(--ms-ink);
  }

  .scm-ms__spots-kicker {
    opacity: calc(0.4 + var(--p) * 2);
  }

  .scm-ms__spot-media {
    position: relative;
    align-self: center;
    width: min(100%, calc(100svh - 150px));
    height: auto;
    transform: scale(calc(0.92 + min(var(--p) * 3, 1) * 0.08));
  }

  .scm-ms__spot-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .scm-ms__spot {
    --show: clamp(0, calc((var(--p) * (var(--n) + 0.6) - var(--i) - 0.25) * 3), 1);

    position: absolute;
    left: var(--x);
    top: var(--y);
    width: 0;
    height: 0;
  }

  .scm-ms__spot-dot {
    position: absolute;
    left: -5px;
    top: -5px;
    width: 10px;
    height: 10px;
    background: var(--ms-red);
    box-shadow: 0 0 0 calc(var(--show) * 6px) rgb(198 40 40 / 25%);
    transform: scale(var(--show));
  }

  .scm-ms__spot-line {
    position: absolute;
    top: -0.5px;
    width: clamp(22px, 7vw, 90px);
    height: 2px;
    margin-top: -0.5px;
    background: var(--ms-red);
    transform: scaleX(var(--show));
  }

  .scm-ms__spot--right .scm-ms__spot-line {
    left: 8px;
    transform-origin: left;
  }

  .scm-ms__spot--left .scm-ms__spot-line {
    right: 8px;
    transform-origin: right;
  }

  .scm-ms__spot-tag {
    --tag: clamp(0, calc(var(--show) * 2 - 1), 1);

    position: absolute;
    top: 0;
    width: max-content;
    max-width: min(34vw, 220px);
    padding: 7px 10px;
    background: rgb(26 21 18 / 88%);
    color: var(--ms-white);
    font-size: clamp(11px, 2.9vw, 14px);
    line-height: 1.3;
    opacity: var(--tag);
    transform: translateY(calc(-50% + (1 - var(--tag)) * 8px));
  }

  .scm-ms__spot-tag b {
    display: block;
    margin-bottom: 2px;
    color: var(--ms-taupe);
    font-size: 0.78em;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .scm-ms__spot--right .scm-ms__spot-tag {
    left: calc(clamp(22px, 7vw, 90px) + 8px);
  }

  .scm-ms__spot--left .scm-ms__spot-tag {
    right: calc(clamp(22px, 7vw, 90px) + 8px);
    text-align: right;
  }

  /* 4 · Details */
  .scm-ms__features {
    position: relative;
    display: grid;
    background: var(--ms-paper);
    color: var(--ms-ink);
  }

  .scm-ms__features-media {
    position: sticky;
    top: 0;
    z-index: 0;
    height: 62svh;
    overflow: hidden;
    background: var(--ms-paper);
  }

  .scm-ms__feature-img {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: scale(1.08);
    transition: opacity 0.7s ease, transform 1.2s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .scm-ms__feature-img.is-active {
    opacity: 1;
    transform: scale(1);
  }

  .scm-ms__feature-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
  }

  .scm-ms__progress {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 3px;
    background: rgb(42 36 32 / 12%);
  }

  .scm-ms__progress span {
    display: block;
    height: 100%;
    background: var(--ms-red);
    transform: scaleX(0.33);
    transform-origin: left;
    transition: transform 0.6s ease;
  }

  .scm-ms__features-text {
    position: relative;
    z-index: 1;
  }

  .scm-ms__feature {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 70svh;
    padding: 0 0 32px;
    box-sizing: border-box;
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  .scm-ms__feature.is-active {
    opacity: 1;
  }

  .scm-ms__feature-card {
    max-width: 34ch;
    padding: 22px 20px 20px;
    background: var(--ms-paper);
  }

  .scm-ms__index {
    margin: 0 0 6px;
    color: var(--ms-red);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.2em;
  }

  .scm-ms__feature-title {
    margin: 0 0 10px;
    font-family: var(--ms-head);
    font-size: clamp(30px, 8vw, 56px);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.025em;
  }

  .scm-ms__feature-text {
    margin: 0;
    font-size: 17px;
    line-height: 1.55;
  }

  /* 5 · Auf einen Blick */
  .scm-ms__facts {
    padding: clamp(64px, 12vh, 120px) 20px clamp(48px, 8vh, 80px);
    background: var(--ms-night);
  }

  .scm-ms__facts-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    margin: 0;
    padding: 0;
    list-style: none;
    background: rgb(201 184 166 / 22%);
    border: 1px solid rgb(201 184 166 / 22%);
  }

  .scm-ms__fact {
    display: grid;
    align-content: end;
    gap: 8px;
    min-height: 160px;
    padding: 20px 16px;
    background: var(--ms-night);
  }

  .scm-ms__fact-big {
    font-family: var(--ms-head);
    font-size: clamp(30px, 8vw, 56px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
    background: var(--ms-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    font-variant-numeric: tabular-nums;
  }

  .scm-ms__fact-small {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  [data-reveal] {
    opacity: 0;
    transform: translateY(32px) scale(0.98);
    filter: blur(6px);
    transition: opacity 0.9s ease, transform 1s cubic-bezier(0.2, 0.7, 0.2, 1), filter 0.9s ease;
    transition-delay: calc(var(--d, 0) * 120ms);
  }

  [data-reveal].is-in {
    opacity: 1;
    transform: none;
    filter: none;
  }

  /* 6 · Abschluss */
  .scm-ms__outro {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 80svh;
    padding: 80px 20px;
    overflow: hidden;
    text-align: center;
  }

  .scm-ms__glow--outro {
    --p: 1;

    top: 50%;
  }

  .scm-ms__outro-inner {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
    gap: 14px;
  }

  .scm-ms__outro-title {
    margin: 0;
    max-width: 14ch;
    font-family: var(--ms-head);
    font-size: clamp(38px, 9.5vw, 96px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.035em;
    background: var(--ms-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .scm-ms__price {
    margin: 0;
    font-size: 18px;
    letter-spacing: 0.06em;
    opacity: 0.85;
  }

  .scm-ms__cta {
    display: inline-grid;
    place-items: center;
    min-height: 54px;
    margin-top: 8px;
    padding: 0 34px;
    background: var(--ms-white);
    color: var(--ms-ink);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color 0.2s, color 0.2s;
  }

  .scm-ms__cta:hover {
    background: var(--ms-red);
    color: var(--ms-white);
  }

  .scm-ms__cta:focus-visible {
    outline: 2px solid var(--ms-white);
    outline-offset: 4px;
  }

  /* Desktop */
  @media screen and (min-width: 990px) {
    .scm-ms__features {
      grid-template-columns: 1fr 1fr;
    }

    .scm-ms__features-media {
      height: 100vh;
      height: 100svh;
    }

    .scm-ms__feature {
      justify-content: center;
      min-height: 100svh;
      padding: 0 8vw;
      opacity: 0.2;
    }

    .scm-ms__feature-card {
      padding: 0;
      background: none;
    }

    .scm-ms__facts {
      padding-inline: 6vw;
    }

    .scm-ms__facts-grid {
      grid-template-columns: repeat(4, 1fr);
    }

    .scm-ms__fact {
      min-height: 240px;
      padding: 28px 24px;
    }
  }

  /* Bewegung reduzieren: alles sichtbar, keine Sticky-Strecken */
  .scm-ms.is-static .scm-ms__stage {
    --p: 1;
    height: auto;
  }

  .scm-ms.is-static .scm-ms__sticky {
    position: relative;
    height: auto;
    min-height: 80svh;
    padding-block: 64px;
  }

  .scm-ms.is-static .scm-ms__hero-copy {
    opacity: 1;
    transform: none;
  }

  .scm-ms.is-static .scm-ms__hero-media {
    height: 60svh;
    transform: none;
  }

  .scm-ms.is-static .scm-ms__caption:not(:last-child) {
    display: none;
  }

  .scm-ms.is-static .scm-ms__spot-media {
    height: 70svh;
  }

  .scm-ms.is-static [data-reveal] {
    opacity: 1;
    transform: none;
    filter: none;
    transition: none;
  }

  .scm-ms.is-static .scm-ms__feature-img {
    transition: none;
  }
{% endstylesheet %}

